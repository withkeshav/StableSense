# StableSense backend environment. Copy to backend/.env (git-ignored) and fill in.
# Never commit .env. All values below are placeholders.

# Server
# PORT=8787
# DATA_DIR=/opt/stablesense/backend/data

# AI (OpenAI-compatible endpoint; e.g. OpenRouter, DeepSeek, or OpenAI)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_FALLBACK_MODEL=

# Minimum minutes between AI narrative generations (120 recommended).
# The ai job self-gates on this value, so a frequent crontab entry is safe.
# AI_CADENCE_MIN=120

# Market data source (Helix). The default fetch/stress path reads Helix trends;
# HELIX_API_KEY is optional auth for helix.withkeshav.com when configured.
# HELIX_API_BASE=https://helix.withkeshav.com
# HELIX_API_KEY=
# HELIX_FETCH_CHAINS=1   # set to 0 to skip per-chain snapshots (they are ~3MB per asset per fetch)

# Legacy upstreams. When LEGACY_UPSTREAMS=1, fetch.js, stress.js and the
# /api/healthz status switch to the pre-Helix path: DefiLlama (supply/chains)
# + CoinGecko (prices) instead of Helix. Used only for historical backfills
# or as a deliberate fallback toggle; the default (unset or any value other
# than 1) runs the Helix path.
# LEGACY_UPSTREAMS=
